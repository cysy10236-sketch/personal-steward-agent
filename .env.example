# ==============================================================================
# Personal-Steward-Agent (TripLedger) 环境配置模板 (.env.example)
# 未配置真实密钥时自动回退至内置高仿真离线引擎 MockLLMProvider
# ==============================================================================

# 1. OpenAI 兼容云端端点（支持 DeepSeek / 阿里云百炼 Qwen / OpenAI）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 2. 可选：端侧本地隐私推理端点（如本地 Ollama http://127.0.0.1:11434/v1）
LOCAL_SLM_BASE_URL=
LOCAL_SLM_API_KEY=ollama

# 3. 三级动态路由模型标识
LLM_MODEL=deepseek-flash
SLM_MODEL=deepseek-flash
LOCAL_PRIVACY_MODEL=deepseek-flash
VLM_MODEL=deepseek-flash

# 4. 确定性与延迟超参数
TEMPERATURE=0.0
RANDOM_SEED=42
REQUEST_TIMEOUT_SECONDS=60.0

# 5. 混合记忆、动态路由与差旅安全审批阈值
MEMORY_DB_PATH=runtime_data/memory/steward_memory.sqlite3
EMBEDDING_DIM=256
MEMORY_BASE_HALF_LIFE_HOURS=168.0
MEMORY_PPR_ALPHA=0.85
MEMORY_ABSTENTION_THRESHOLD=0.18
ROUTER_COMPLEXITY_THRESHOLD=0.45
ROUTER_TOOL_BUDGET=6
AUTO_REIMBURSE_LIMIT_CNY=1000.0
AGENT_MAX_REFLECT_RETRIES=2

# 6. 可观测性与工作区路径
TRACE_LOG_PATH=logs/trace_events.jsonl
SANDBOX_WORKSPACE_DIR=runtime_data/workspace
ARTIFACT_CACHE_DIR=artifacts_cache
