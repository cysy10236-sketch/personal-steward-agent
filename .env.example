# TripLedger Steward (personal-steward-agent v2.0) Environment Configuration
# Leave OPENAI_API_KEY as placeholder to run offline deterministic MockLLMProvider.

OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Optional local private endpoint (e.g., Ollama http://127.0.0.1:11434/v1).
# When unset, PII inputs trigger Fail-Closed local PrivacyVault redaction before cloud calls.
LOCAL_SLM_BASE_URL=
LOCAL_SLM_API_KEY=ollama

# Heterogeneous model tiers
LLM_MODEL=deepseek-v4-pro
SLM_MODEL=deepseek-flash
VLM_MODEL=deepseek-flash
LOCAL_PRIVACY_MODEL=qwen2.5:7b

# Reproducibility & runtime bounds
TEMPERATURE=0.0
RANDOM_SEED=42
REQUEST_TIMEOUT_SECONDS=60.0

# Memory, router, sandbox & checkpoint thresholds
MEMORY_DB_PATH=runtime_data/memory/steward_memory.sqlite3
MCP_DB_PATH=runtime_data/mcp/steward_mcp.sqlite3
CHECKPOINT_DB_PATH=runtime_data/checkpoints/steward_checkpoints.sqlite3
MEMORY_PPR_ALPHA=0.85
MEMORY_ABSTENTION_THRESHOLD=0.18
ROUTER_COMPLEXITY_THRESHOLD=0.45
ROUTER_TOOL_BUDGET=6
AUTO_REIMBURSE_LIMIT_CNY=1000.0
AGENT_MAX_REFLECT_RETRIES=2
